<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0a0f1e">
  <TextView android:text="✈️ پرواز — اسکنر پورت سالم" android:textColor="#e6eefc" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:text="همان موتور hunting خود FCAE — روی نت خودت اجرا می‌شود" android:textColor="#8aa0c8" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
    <Button android:id="@+id/btnScan" android:text="▶ شروع اسکن" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnStop" android:text="⏹ توقف" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
    <Button android:id="@+id/btnCopy" android:text="📋 کپی همه" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnBot" android:text="🤖 ارسال به ربات" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
  </LinearLayout>
  <TextView android:id="@+id/tvStat" android:text="آماده — 54 پورت × 7 ساب‌نت" android:textColor="#22d3ee" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="#060a18">
    <TextView android:id="@+id/tvLog" android:text="I [*] parvaz scanner ready — FCAE hunting balanced&#10;I [*] روی گوشی دکمه شروع را بزن" android:textColor="#8aa0c8" android:fontFamily="monospace" android:textSize="11sp" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </ScrollView>
  <TextView android:text="سالم‌ها (بهترین اول):" android:textColor="#e6eefc" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent" android:layout_height="140dp" android:background="#0d1731" android:layout_marginTop="4dp"/>
</LinearLayout>